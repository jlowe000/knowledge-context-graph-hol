  region network (
    name: 1. Prepare the graph network
    type: staticContent
    layout {
      sequence: 30
      slot: body
    }
    appearance {
      template: @/standard
      templateOptions: #DEFAULT#
    }
    source {
      htmlCode:
      ```html
      <p>Create or verify this installation's private RDF network. An existing matching network is retained. This action does not load the public collection.</p>
      ```
    }
  )
  region create-credential (
    name: Create a local OCI signing credential
    type: staticContent
    layout {
      sequence: 35
      slot: body
    }
    appearance {
      template: @/standard
      templateOptions: #DEFAULT#
    }
    source {
      htmlCode:
      ```html
      <p>If your facilitator has already created a credential, select it under Configure model access. Otherwise, enter the four values from the same OCI API signing key here.</p>
      <p>This creates <strong>OCI_USER_CRED</strong> only when that name is unused. It never replaces an existing credential. All four fields are masked and cleared after submitting or leaving this page. Creating the credential does not contact a model; test the model connection separately after configuring its profile.</p>
      ```
    }
    security {
      authorizationScheme: @deployment-installer
    }
  )
  pageItem P900_OCI_USER (
    type: password
    label {
      label: OCI user OCID
      alignment: left
    }
    layout {
      sequence: 10
      region: @create-credential
      slot: regionBody
    }
    appearance {
      template: @/optional-floating
    }
    settings {
      submitWhenEnterPressed: false
    }
    validation {
      valueRequired: false
      maxLength: 256
    }
    advanced {
      customAttributes: autocomplete="off" spellcheck="false" autocapitalize="none"
      warnOnUnsavedChanges: ignore
    }
    source {
      type: null
      used: always
    }
    sessionState {
      dataType: varchar2
      storage: request
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
      authorizationScheme: @deployment-installer
      encryptSessionState: true
    }
    help {
      inlineHelpText: User OCID for the account whose API signing key will be used.
    }
  )
