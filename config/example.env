# Optional direct-driver automation only. SQL Worksheet requires no local DB config.
# Bash: copy privately to config/local.env (ignored), edit and source explicitly.
export KCV_DB_USER=KCV_LAB
export KCV_DB_DSN='replace-with-serverless-connection-alias-or-TLS-DSN'
# Passwords are prompted; optionally export them from a private secret mechanism.
# export KCV_WALLET_DIR='/absolute/private/wallet-directory'
# export KCV_WALLET_PASSWORD='set-privately-if-required'
export KCV_AI_PROFILE=KCV_GENAI
# Existing credential owned by KCV_LAB; alternatively OCI$RESOURCE_PRINCIPAL.
export KCV_AI_CREDENTIAL='OCI_USER_CRED'
export KCV_OCI_COMPARTMENT='replace-with-compartment-OCID'
export KCV_OCI_REGION='replace-with-accessible-region'
export KCV_AI_MODEL='replace-with-currently-accessible-model-id'
