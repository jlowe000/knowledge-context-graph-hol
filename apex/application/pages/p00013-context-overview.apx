  region operations-help (
    name: Unfinished operations
    type: staticContent
    layout {
      sequence: 50
      slot: body
    }
    appearance {
      template: @/standard
      templateOptions: #DEFAULT#
    }
    source {
      htmlCode:
      ```html
      <p>If a request was interrupted, review its status before trying again. An uncertain response may already have reached the provider. Abandoning it records your decision to continue; it does not cancel a provider request or claim that it failed. A running worker cannot be abandoned.</p>
      ```
    }
  )
  region operations (
    name: Operations requiring attention
    type: classicReport
    layout {
      sequence: 60
      slot: body
    }
    source {
      location: localDatabase
      type: sqlQuery
      sqlQuery:
      ```sql
SELECT j.action,j.phase,j.error_code,
 CASE WHEN j.session_id IS NOT NULL THEN 'Open conversation' END open_label,
 CASE WHEN j.session_id IS NOT NULL THEN apex_page.get_url(p_page=>1,p_clear_cache=>'1',p_items=>'P1_SESSION_ID',p_values=>j.session_id) END open_url
FROM JSON_TABLE(kcv_personal_journey.operations(:P13_CONTEXT_ID),'$[*]'
 COLUMNS(ord FOR ORDINALITY,action VARCHAR2(32) PATH '$.action',phase VARCHAR2(20) PATH '$.phase',error_code NUMBER PATH '$.error_code',session_id VARCHAR2(40) PATH '$.session_id')) j ORDER BY j.ord
      ```
    }
    appearance {
      template: @/standard
      templateOptions: #DEFAULT#
    }
    reportLayout {
      numberOfRowsType: staticValue
      numberOfRows: 40
    }
    componentAppearance {
      template: @/standard
    }
    messages {
      whenNoDataFound: No records yet.
    }
    column ACTION (
      reportColumnQueryId: 1
      type: plainText
      heading {
        heading: Requested action
        alignment: start
      }
      layout {
        sequence: 10
        columnAlignment: start
      }
      sorting {
        sortable: false
      }
      security {
        escapeSpecialChars: true
      }
    )
    column PHASE (
      reportColumnQueryId: 2
      type: plainText
      heading {
        heading: Recorded status
