page 10 (
  name: My Contexts
  alias: MY-CONTEXTS
  title: My Contexts
  appearance {
    pageTemplate: @/standard
    templateOptions: #DEFAULT#
  }
  navigation {
    warnOnUnsavedChanges: true
  }
  security {
    authentication: required
    pageAccessProtection: argumentsMustHaveChecksum
    formAutoComplete: false
  }
  region library (
    name: Your saved learning contexts
    type: staticContent
    layout {
      sequence: 10
      slot: body
    }
    appearance {
      template: @/standard
      templateOptions: #DEFAULT#
    }
    headerAndFooter {
      headerText:
      ```html
      <p>Save an idea, question or learning context and return to it after signing in again. My Contexts shows only work owned by your signed-in account in this application. Search by wording or meaning across titles and saved context details. With no search, the most recently updated contexts appear first.</p><p>Save a draft, review and apply it, then start a conversation. Each conversation keeps its selected context revision until you explicitly adopt a newer one. To bring back archived work, select Archived, choose Search, open the context and choose Unarchive. You can also explore the fictional sample journeys.</p>
      ```
    }
    source {
      htmlCode:
      ```html
      <p role="status">&P10_SEARCH_NOTICE!HTML.</p>
      ```
    }
  )
  pageItem P10_SEARCH (
    type: textField
    label {
      label: Search your contexts
      alignment: left
    }
    layout {
      sequence: 10
      region: @library
      slot: regionBody
    }
    appearance {
      template: @/optional-floating
      width: 60
      valuePlaceholder: Find my ideas about reducing project information delays
    }
    validation {
      valueRequired: false
      maxLength: 200
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: unrestricted
    }
  )
  pageItem P10_STATUS (
    type: selectList
    label {
      label: Status
      alignment: left
    }
    layout {
      sequence: 20
      region: @library
      slot: regionBody
    }
    appearance {
      template: @/optional-floating
    }
    validation {
      valueRequired: false
    }
    lov {
      type: staticValues
      staticValues: STATIC:All;,Draft;DRAFT,Active;ACTIVE,Archived;ARCHIVED
      displayNullValue: false
      displayExtraValues: false
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: unrestricted
    }
  )
  pageItem P10_CURSOR (
    type: hidden
    layout {
      sequence: 30
      region: @library
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
  pageItem P10_NEXT (
    type: hidden
    layout {
      sequence: 40
      region: @library
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
  pageItem P10_RESULTS (
    type: hidden
    layout {
      sequence: 50
      region: @library
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    sessionState {
      dataType: clob
      storage: request
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
  pageItem P10_SEARCH_NOTICE (
    type: hidden
    layout {
      sequence: 60
      region: @library
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    sessionState {
      storage: request
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
  button search (
    buttonName: SEARCH
    label: Search
    layout {
      sequence: 10
      region: @library
      slot: bottom
      horizontalAlignment: left
    }
    appearance {
      buttonTemplate: @/text
      hot: false
    }
    behavior {
      action: submitPage
      executeValidations: true
      showProcessing: true
      warnOnUnsavedChanges: doNotCheck
    }
  )
  button new (
    buttonName: NEW
    label: Create context
    layout {
      sequence: 20
      region: @library
      slot: bottom
    }
    appearance {
      buttonTemplate: @/text
      hot: true
    }
    behavior {
      action: redirectThisApp
      target: {
        page: 11
        clearCache: 11
      }
    }
  )
  button samples (
    buttonName: SAMPLES
    label: Use a sample
    layout {
      sequence: 30
      region: @library
      slot: bottom
    }
    appearance {
      buttonTemplate: @/text
      hot: false
    }
    behavior {
      action: redirectThisApp
      target: {
        page: 14
        clearCache: 14
      }
    }
  )
  button next (
    buttonName: NEXT
    label: Next contexts
    layout {
      sequence: 40
      region: @contexts
      slot: bottom
    }
    appearance {
      buttonTemplate: @/text
      hot: false
    }
    behavior {
      action: submitPage
      executeValidations: true
      showProcessing: true
      warnOnUnsavedChanges: doNotCheck
    }
    serverSideCondition {
      type: itemIsNotNull
      item: P10_NEXT
    }
  )
  button first (
    buttonName: FIRST
    label: Start of list
    layout {
      sequence: 50
      region: @contexts
      slot: bottom
    }
    appearance {
      buttonTemplate: @/text
      hot: false
    }
    behavior {
      action: submitPage
      executeValidations: true
      showProcessing: true
      warnOnUnsavedChanges: doNotCheck
    }
    serverSideCondition {
      type: itemIsNotNull
      item: P10_CURSOR
    }
  )
  process move-library-cursor (
    name: move library cursor
    type: executeCode
    source {
      plsqlCode:
      ```plsql
      BEGIN
       IF :REQUEST IN ('SEARCH','FIRST') THEN :P10_CURSOR := NULL;
       ELSIF :REQUEST = 'NEXT' THEN :P10_CURSOR := :P10_NEXT; END IF;
      END;
      ```
    }
    execution {
      sequence: 10
      point: processing
    }
    error {
      displayLocation: inlineInNotification
    }
  )
  process prepare-library (
    name: prepare library
    type: executeCode
    source {
      plsqlCode:
      ```plsql
      DECLARE
       l_result CLOB;
      BEGIN
       -- One search per page request. Report rendering and pagination metadata
       -- consume this request-only result; they never invoke the model again.
       apex_session_state.set_value(p_item=>'P10_RESULTS',p_value=>TO_CLOB('{"contexts":[]}'),p_commit=>FALSE);
       :P10_NEXT := NULL;
       :P10_SEARCH_NOTICE := NULL;
       l_result := kcv_personal_context_api.list_contexts(:P10_STATUS,:P10_SEARCH,:P10_CURSOR,10);
       apex_session_state.set_value(p_item=>'P10_RESULTS',p_value=>l_result,p_commit=>FALSE);
       :P10_NEXT := JSON_VALUE(l_result,'$.next_cursor');
       :P10_SEARCH_NOTICE := JSON_VALUE(l_result,'$.search_notice' RETURNING VARCHAR2(4000));
      END;
      ```
    }
    execution {
      sequence: 10
      point: beforeHeader
    }
  )
  region contexts (
    name: My contexts
    type: classicReport
    layout {
      sequence: 20
      slot: body
    }
    source {
      location: localDatabase
      type: sqlQuery
      sqlQuery:
      ```sql
      SELECT j.title, SUBSTR(j.objective_preview,1,240) objective_preview, j.match_reason,
       CASE WHEN j.deletion_status='PENDING' THEN 'Deletion unfinished' ELSE INITCAP(j.lifecycle) END lifecycle, j.updated_at,
       CASE WHEN j.deletion_status='PENDING' THEN
        apex_page.get_url(p_page=>15,p_clear_cache=>'15',p_items=>'P15_CONTEXT_ID',p_values=>j.context_id)
       ELSE apex_page.get_url(p_page=>13,p_clear_cache=>'13',p_items=>'P13_CONTEXT_ID',p_values=>j.context_id) END detail_url
      FROM JSON_TABLE(apex_session_state.get_clob('P10_RESULTS'), '$.contexts[*]'
       COLUMNS(display_order FOR ORDINALITY, context_id VARCHAR2(32) PATH '$.context_id', title VARCHAR2(800) PATH '$.title',
       objective_preview VARCHAR2(960) PATH '$.objective_preview', match_reason VARCHAR2(4000) PATH '$.match_reason',
       lifecycle VARCHAR2(16) PATH '$.lifecycle', deletion_status VARCHAR2(16) PATH '$.deletion_status', updated_at VARCHAR2(80) PATH '$.updated_at')) j
      ORDER BY j.display_order
      ```
    }
    appearance {
      template: @/standard
      templateOptions: #DEFAULT#
    }
    reportLayout {
      numberOfRowsType: staticValue
      numberOfRows: 10
    }
    componentAppearance {
      template: @/standard
    }
    messages {
      whenNoDataFound: No contexts match. Try different wording or clear your search.
    }
    column TITLE (
      reportColumnQueryId: 1
      type: link
      heading {
        heading: Context
        alignment: start
      }
      layout {
        sequence: 10
        columnAlignment: start
      }
      sorting {
        sortable: false
      }
      security {
        escapeSpecialChars: true
      }
      link {
        target: {
          type: url
          url: #DETAIL_URL#
        }
        linkText: #TITLE#
      }
    )
    column OBJECTIVE_PREVIEW (
      reportColumnQueryId: 2
      type: plainText
      heading {
        heading: Objective
        alignment: start
      }
      layout {
        sequence: 20
        columnAlignment: start
      }
      sorting {
        sortable: false
      }
      security {
        escapeSpecialChars: true
      }
    )
    column MATCH_REASON (
      reportColumnQueryId: 3
      type: plainText
      heading {
        heading: Why it matched
        alignment: start
      }
      layout {
        sequence: 30
        columnAlignment: start
      }
      sorting {
        sortable: false
      }
      security {
        escapeSpecialChars: true
      }
    )
    column LIFECYCLE (
      reportColumnQueryId: 4
      type: plainText
      heading {
        heading: Status
        alignment: start
      }
      layout {
        sequence: 40
        columnAlignment: start
      }
      sorting {
        sortable: false
      }
      security {
        escapeSpecialChars: true
      }
    )
    column UPDATED_AT (
      reportColumnQueryId: 5
      type: plainText
      heading {
        heading: Last updated
        alignment: start
      }
      layout {
        sequence: 50
        columnAlignment: start
      }
      sorting {
        sortable: false
      }
      security {
        escapeSpecialChars: true
      }
    )
    column DETAIL_URL (
      reportColumnQueryId: 6
      type: hidden
      layout {
        sequence: 60
      }
      security {
        escapeSpecialChars: true
      }
    )
  )
)
