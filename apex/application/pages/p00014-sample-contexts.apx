page 14 (
  name: Sample Contexts
  alias: SAMPLE-CONTEXTS
  title: Sample Contexts
  appearance {
    pageTemplate: @/standard
    templateOptions: #DEFAULT#
  }
  security {
    authentication: required
    pageAccessProtection: argumentsMustHaveChecksum
    formAutoComplete: false
  }
  region samples (
    name: Choose a starting point
    type: staticContent
    layout {
      sequence: 10
      slot: body
    }
    appearance {
      template: @/standard
      templateOptions: #DEFAULT#
    }
    source {
      htmlCode:
      ```html
      <p>Explore the fictional learners in the existing conversation workspace, or copy suggested questions and topics into a draft of your own.</p>
      <p>A copy clears the fictional person, role, organisation, background and constraints. Review the suggestions as your own starting point. The original sample is unchanged.</p>
      ```
    }
  )
  pageItem P14_SAMPLE (
    type: selectList
    label {
      label: Starting example
    }
    layout {
      sequence: 10
      region: @samples
      slot: regionBody
    }
    appearance {
      template: @/required-floating
    }
    validation {
      valueRequired: true
    }
    lov {
      type: staticValues
      staticValues: STATIC:Alex - engineering information discovery;CTX01,Sam - evidence and traceability;CTX02,Casey - connected healthcare;CTX03
      displayNullValue: false
      displayExtraValues: false
    }
    default {
      type: static
      staticValue: CTX01
    }
  )
  pageItem P14_TITLE (
    type: textField
    label {
      label: Name for your context
    }
    layout {
      sequence: 20
      region: @samples
      slot: regionBody
    }
    appearance {
      template: @/required-floating
      width: 60
    }
    validation {
      valueRequired: true
      maxLength: 200
    }
  )
  pageItem P14_TOKEN (
    type: hidden
    layout {
      sequence: 30
      region: @samples
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
  button copy (
    buttonName: COPY_SAMPLE
    label: Save as my draft
    layout {
      sequence: 10
      region: @samples
      slot: bottom
    }
    appearance {
      buttonTemplate: @/text
      hot: true
    }
    behavior {
      action: submitPage
      executeValidations: true
      showProcessing: true
      warnOnUnsavedChanges: doNotCheck
    }
  )
  button explore (
    buttonName: EXPLORE
    label: Explore the samples
    layout {
      sequence: 20
      region: @samples
      slot: bottom
    }
    appearance {
      buttonTemplate: @/text
    }
    behavior {
      action: redirectThisApp
      target: {
        page: 1
        clearCache: 1
      }
      warnOnUnsavedChanges: doNotCheck
    }
  )
  process initialize-token (
    name: Initialize request token
    type: executeCode
    source {
      plsqlCode:
      ```plsql
      BEGIN
        IF :REQUEST IS NULL THEN :P14_TOKEN:=RAWTOHEX(SYS_GUID()); END IF;
      END;
      ```
    }
    execution {
      sequence: 10
      point: beforeHeader
    }
  )
  process copy-reviewed-sample (
    name: Copy sample into owned draft
    type: executeCode
    source {
      plsqlCode:
      ```plsql
      DECLARE l_result JSON_OBJECT_T; BEGIN
        l_result:=JSON_OBJECT_T.parse(kcv_personal_context_api.copy_sample(:P14_SAMPLE,:P14_TITLE,:P14_TOKEN));
        apex_util.redirect_url(apex_page.get_url(p_page=>11,p_clear_cache=>'11',p_items=>'P11_CONTEXT_ID',p_values=>l_result.get_string('context_id')));
        apex_application.stop_apex_engine;
      END;
      ```
    }
    execution {
      sequence: 10
      point: processing
    }
    serverSideCondition {
      whenButtonPressed: @copy
    }
    error {
      displayLocation: inlineInNotification
    }
  )
)
