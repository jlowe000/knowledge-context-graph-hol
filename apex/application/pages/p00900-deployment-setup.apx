  region profile (
    name: 2. Configure model access
    type: staticContent
    layout {
      sequence: 40
      slot: body
    }
    appearance {
      template: @/standard
      templateOptions: #DEFAULT#
    }
    source {
      htmlCode:
      ```html
      <p>Choose a credential already created privately in this database schema. Enter the OCI region, compartment OCID and supported model <strong>name</strong>. Do not enter a model endpoint, password or private key.</p><p>If the existing profile is ready, keep it and choose Test model connection. Changing the profile requires another explicit connection test. Form values are used for this request and are not supplied as export defaults.</p>
      ```
    }
  )
  pageItem P900_CREDENTIAL (
    type: selectList
    label {
      label: Existing database credential
      alignment: left
    }
    layout {
      sequence: 10
      region: @profile
      slot: regionBody
    }
    appearance {
      template: @/optional-floating
    }
    validation {
      valueRequired: false
    }
    lov {
      type: sqlQuery
      sqlQuery:
      ```sql
      SELECT credential display_value, credential return_value
      FROM JSON_TABLE(apex_session_state.get_clob('P900_CREDENTIALS'),'$[*]' COLUMNS(credential VARCHAR2(128) PATH '$'))
      ORDER BY credential
      ```
      displayNullValue: true
      nullDisplayValue: Choose a prepared credential
      displayExtraValues: false
    }
    sessionState {
      storage: request
    }
    security {
      sessionStateProtection: unrestricted
    }
  )
