page 15 (
  name: Delete context
  alias: DELETE-CONTEXT
  title: Delete context
  appearance {
    pageTemplate: @/standard
    templateOptions: #DEFAULT#
  }
  navigation {
    warnOnUnsavedChanges: false
  }
  security {
    authorizationScheme: @learning-ready
    authentication: required
    pageAccessProtection: argumentsMustHaveChecksum
    formAutoComplete: false
  }
  region confirmation (
    name: Review before deleting
    type: staticContent
    layout {
      sequence: 10
      slot: body
    }
    appearance {
      template: @/standard
      templateOptions: #DEFAULT#
    }
    source {
      htmlCode:
      ```html
      <p>Delete <strong>&P15_TITLE!HTML.</strong>?</p>
      <p>This permanently removes this context, its draft and ready revisions, saved conversations, answers, evidence explanations and observations. It also removes the context's private graph data. This cannot be undone.</p>
      <p>Your other contexts, the fictional samples and the shared public knowledge collection remain available. Choose Archive on the context overview if you want to keep this work for later.</p>
      <p role="status">&P15_NOTICE!HTML.</p>
      ```
    }
  )
  pageItem P15_CONTEXT_ID (
    type: hidden
    layout {
      sequence: 1
      region: @confirmation
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
  pageItem P15_VERSION (
    type: hidden
    layout {
      sequence: 2
      region: @confirmation
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
  pageItem P15_HEAD (
    type: hidden
    layout {
      sequence: 3
      region: @confirmation
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
  pageItem P15_DIGEST (
    type: hidden
    layout {
      sequence: 4
      region: @confirmation
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
  pageItem P15_TOKEN (
    type: hidden
    layout {
      sequence: 5
      region: @confirmation
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
  pageItem P15_TITLE (
    type: hidden
    layout {
      sequence: 6
      region: @confirmation
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
  pageItem P15_NOTICE (
    type: hidden
    layout {
      sequence: 7
      region: @confirmation
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
  pageItem P15_COUNTS (
    type: hidden
    layout {
      sequence: 8
      region: @confirmation
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
  pageItem P15_STATUS (
    type: hidden
    layout {
      sequence: 9
      region: @confirmation
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
  button cancel (
    buttonName: CANCEL
    label: Cancel
    layout {
      sequence: 10
      region: @confirmation
      slot: bottom
    }
    appearance {
      buttonTemplate: @/text
      hot: false
    }
    behavior {
      action: redirectThisApp
      target: {
        page: 10
        clearCache: 10
      }
    }
    serverSideCondition {
      type: item=value
      item: P15_STATUS
      value: READY
    }
  )
  button return-to-library (
    buttonName: LIBRARY
    label: My Contexts
    layout {
      sequence: 10
      region: @confirmation
      slot: bottom
    }
    appearance {
      buttonTemplate: @/text
      hot: false
    }
    behavior {
      action: redirectThisApp
      target: {
        page: 10
        clearCache: 10
      }
    }
    serverSideCondition {
      type: expression
      language: plsql
      plsqlExpression: :P15_STATUS <> 'READY'
    }
  )
  button delete-permanently (
    buttonName: DELETE_PERMANENTLY
    label: Delete permanently
    layout {
      sequence: 20
      region: @confirmation
      slot: bottom
    }
    appearance {
      buttonTemplate: @/text
      hot: true
    }
    behavior {
      action: submitPage
      executeValidations: true
      showProcessing: true
      warnOnUnsavedChanges: doNotCheck
    }
    serverSideCondition {
      type: item=value
      item: P15_STATUS
      value: READY
    }
  )
  button retry-deletion (
    buttonName: RETRY_DELETION
    label: Retry deletion
    layout {
      sequence: 20
      region: @confirmation
      slot: bottom
    }
    appearance {
      buttonTemplate: @/text
      hot: true
    }
    behavior {
      action: submitPage
      executeValidations: true
      showProcessing: true
      warnOnUnsavedChanges: doNotCheck
    }
    serverSideCondition {
      type: item=value
      item: P15_STATUS
      value: PENDING
    }
  )
  region deletion-counts (
    name: Saved work to remove
    type: classicReport
    layout {
      sequence: 20
      slot: body
    }
    source {
      location: localDatabase
      type: sqlQuery
      sqlQuery:
      ```sql
      WITH counts AS (SELECT :P15_COUNTS doc FROM dual), rows_to_show AS (
       SELECT 1 ord, 'Ready revisions' kind, JSON_VALUE(doc,'$.revisions' RETURNING NUMBER) quantity FROM counts
       UNION ALL SELECT 2, 'Conversations', JSON_VALUE(doc,'$.conversations' RETURNING NUMBER) FROM counts
       UNION ALL SELECT 3, 'Conversation messages', JSON_VALUE(doc,'$.turns' RETURNING NUMBER) FROM counts
       UNION ALL SELECT 4, 'Saved answers', JSON_VALUE(doc,'$.responses' RETURNING NUMBER) FROM counts
       UNION ALL SELECT 5, 'Evidence retrieval records', JSON_VALUE(doc,'$.evidence' RETURNING NUMBER) FROM counts
       UNION ALL SELECT 6, 'Observations', JSON_VALUE(doc,'$.observations' RETURNING NUMBER) FROM counts
      ) SELECT kind, quantity FROM rows_to_show ORDER BY ord
      ```
    }
    appearance {
      template: @/standard
      templateOptions: #DEFAULT#
    }
    reportLayout {
      numberOfRowsType: staticValue
      numberOfRows: 10
    }
    componentAppearance {
      template: @/standard
    }
    column KIND (
      reportColumnQueryId: 1
      type: plainText
      heading {
        heading: Saved work
        alignment: start
      }
      layout {
        sequence: 10
        columnAlignment: start
      }
      sorting {
        sortable: false
      }
      security {
        escapeSpecialChars: true
      }
    )
    column QUANTITY (
      reportColumnQueryId: 2
      type: plainText
      heading {
        heading: Count
        alignment: start
      }
      layout {
        sequence: 20
        columnAlignment: start
      }
      sorting {
        sortable: false
      }
      security {
        escapeSpecialChars: true
      }
    )
  )
  process prepare-deletion (
    name: Prepare deletion review
    type: executeCode
    source {
      plsqlCode:
      ```plsql
      DECLARE j JSON_OBJECT_T; counts JSON_OBJECT_T; current_status VARCHAR2(20); BEGIN
       current_status:=kcv_context_delete.status(:P15_CONTEXT_ID);
       IF :REQUEST IS NULL THEN
        j:=JSON_OBJECT_T.parse(kcv_context_delete.preview(:P15_CONTEXT_ID));
        :P15_TITLE:=j.get_string('title');
        :P15_VERSION:=j.get_number('expected_version');
        :P15_HEAD:=j.get_string('expected_head');
        :P15_DIGEST:=j.get_string('preview_digest');
        :P15_TOKEN:=NVL(j.get_string('request_token'),RAWTOHEX(SYS_GUID()));
        counts:=j.get_object('counts');
        IF counts IS NOT NULL THEN :P15_COUNTS:=counts.to_clob(); ELSE :P15_COUNTS:='{}'; END IF;
        :P15_STATUS:=j.get_string('status');
        :P15_NOTICE:='Review the work listed below before deleting.';
       END IF;
       IF current_status='PENDING' THEN
        :P15_STATUS:='PENDING';
        :P15_NOTICE:='Deletion has started but cleanup is unfinished. This context is unavailable for use. Choose Retry deletion to finish; returning to My Contexts will not undo deletion.';
       ELSIF current_status='DELETED' THEN
        :P15_STATUS:='DELETED'; :P15_NOTICE:='This context has already been deleted.';
       END IF;
      END;
      ```
    }
    execution {
      sequence: 10
      point: beforeHeader
    }
  )
  process delete-reviewed-context (
    name: Delete reviewed context
    type: executeCode
    source {
      plsqlCode:
      ```plsql
      DECLARE result JSON_OBJECT_T; BEGIN
       result:=JSON_OBJECT_T.parse(kcv_context_delete.delete_context(:P15_CONTEXT_ID,:P15_VERSION,:P15_HEAD,:P15_DIGEST,:P15_TOKEN));
       IF result.get_string('status')<>'DELETED' THEN
        RAISE_APPLICATION_ERROR(-20249,'Deletion is unfinished. Use Retry deletion to finish cleanup. Your other contexts are unchanged.');
       END IF;
       apex_application.g_print_success_message:='Context deleted.';
       apex_util.redirect_url(apex_page.get_url(p_page=>10,p_clear_cache=>'10'));
       apex_application.stop_apex_engine;
      END;
      ```
    }
    execution {
      sequence: 10
      point: processing
    }
    serverSideCondition {
      type: expression
      language: plsql
      plsqlExpression: :REQUEST IN ('DELETE_PERMANENTLY','RETRY_DELETION')
    }
    error {
      displayLocation: inlineInNotification
    }
  )
)
