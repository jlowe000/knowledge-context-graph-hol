page 13 (
  name: Context overview
  alias: CONTEXT-OVERVIEW
  title: Context overview
  appearance {
    pageTemplate: @/standard
    templateOptions: #DEFAULT#
  }
  javaScript {
    executeWhenPageLoads:
    ```javascript
    apex.gPageContext$.on('apexafterclosedialog.kcvReview', function (event, data) {
      if (data && String(data.dialogPageId) === '12' && data.P12_CONTEXT_ID === apex.item('P13_CONTEXT_ID').getValue()) {
        window.location.reload();
      }
    });
    ```
  }
  navigation {
    cursorFocus: doNotFocusCursor
    warnOnUnsavedChanges: false
  }
  security {
    authentication: required
    pageAccessProtection: argumentsMustHaveChecksum
    formAutoComplete: false
  }
  region overview (
    name: Your context
    type: staticContent
    layout {
      sequence: 10
      slot: body
    }
    appearance {
      template: @/standard
      templateOptions: #DEFAULT#
    }
    source {
      htmlCode:
      ```html
      <p>Save your draft, review its changes, then apply it as a ready revision. Start or reopen a conversation to explore the public collection. Conversations and earlier answer explanations retain their own context revisions. Archiving makes this work read-only until restored.</p>
      ```
    }
  )
  pageItem P13_CONTEXT_ID (
    type: hidden
    layout {
      sequence: 1
      region: @overview
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
