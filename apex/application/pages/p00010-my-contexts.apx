page 10 (
  name: My Contexts
  alias: MY-CONTEXTS
  title: My Contexts
  appearance {
    pageTemplate: @/standard
    templateOptions: #DEFAULT#
  }
  navigation {
    warnOnUnsavedChanges: true
  }
  security {
    authentication: required
    pageAccessProtection: argumentsMustHaveChecksum
    formAutoComplete: false
  }
  region library (
    name: Your saved learning contexts
    type: staticContent
    layout {
      sequence: 10
      slot: body
    }
    appearance {
      template: @/standard
      templateOptions: #DEFAULT#
    }
    source {
      htmlCode:
      ```html
      <p>Save an idea, question or learning context and return to it after signing in again. Your saved work belongs to this application account. The most recently updated contexts appear first.</p><p>Save a draft, review and apply it, then start a conversation. Each conversation keeps its selected context revision until you explicitly adopt a newer one. You can also explore the fictional sample journeys.</p>
      ```
    }
  )
  pageItem P10_SEARCH (
    type: textField
    label {
      label: Search titles
      alignment: left
    }
    layout {
      sequence: 10
      region: @library
      slot: regionBody
    }
    appearance {
      template: @/optional-floating
      width: 60
    }
    validation {
      valueRequired: false
      maxLength: 200
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: unrestricted
    }
  )
  pageItem P10_STATUS (
    type: selectList
    label {
      label: Status
      alignment: left
    }
    layout {
      sequence: 20
      region: @library
      slot: regionBody
    }
    appearance {
      template: @/optional-floating
    }
    validation {
      valueRequired: false
    }
    lov {
      type: staticValues
      staticValues: STATIC:All;,Draft;DRAFT,Archived;ARCHIVED
      displayNullValue: false
      displayExtraValues: false
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: unrestricted
    }
  )
  pageItem P10_CURSOR (
    type: hidden
    layout {
      sequence: 30
      region: @library
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
  pageItem P10_NEXT (
    type: hidden
    layout {
      sequence: 40
      region: @library
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
  button search (
    buttonName: SEARCH
    label: Search
    layout {
      sequence: 10
      region: @library
      slot: bottom
    }
    appearance {
      buttonTemplate: @/text
      hot: false
    }
    behavior {
      action: submitPage
      executeValidations: true
      showProcessing: true
      warnOnUnsavedChanges: doNotCheck
    }
  )
  button new (
    buttonName: NEW
    label: Create context
    layout {
      sequence: 20
      region: @library
      slot: bottom
    }
    appearance {
      buttonTemplate: @/text
      hot: true
    }
    behavior {
      action: redirectThisApp
      target: {
        page: 11
        clearCache: 11
      }
    }
  )
  button samples (
    buttonName: SAMPLES
    label: Use a sample
    layout {
      sequence: 30
      region: @library
      slot: bottom
    }
    appearance {
      buttonTemplate: @/text
      hot: false
    }
    behavior {
      action: redirectThisApp
      target: {
        page: 14
        clearCache: 14
      }
    }
  )
  button next (
    buttonName: NEXT
    label: Next contexts
    layout {
      sequence: 40
      region: @library
      slot: bottom
    }
    appearance {
      buttonTemplate: @/text
      hot: false
    }
    behavior {
      action: submitPage
      executeValidations: true
      showProcessing: true
      warnOnUnsavedChanges: doNotCheck
    }
    serverSideCondition {
      type: itemIsNotNull
      item: P10_NEXT
    }
  )
  button first (
    buttonName: FIRST
    label: Start of list
    layout {
      sequence: 50
      region: @library
      slot: bottom
    }
    appearance {
      buttonTemplate: @/text
      hot: false
    }
    behavior {
      action: submitPage
      executeValidations: true
      showProcessing: true
      warnOnUnsavedChanges: doNotCheck
    }
    serverSideCondition {
      type: itemIsNotNull
      item: P10_CURSOR
    }
  )
  process move-library-cursor (
    name: move library cursor
    type: executeCode
    source {
      plsqlCode:
      ```plsql
      BEGIN
       IF :REQUEST IN ('SEARCH','FIRST') THEN :P10_CURSOR := NULL;
       ELSIF :REQUEST = 'NEXT' THEN :P10_CURSOR := :P10_NEXT; END IF;
      END;
      ```
    }
    execution {
      sequence: 10
      point: processing
    }
    error {
      displayLocation: inlineInNotification
    }
  )
  process prepare-library (
    name: prepare library
    type: executeCode
    source {
      plsqlCode:
      ```plsql
      DECLARE
       l_result CLOB;
      BEGIN
       l_result := kcv_personal_context_api.list_contexts(:P10_STATUS,:P10_SEARCH,:P10_CURSOR,20);
       :P10_NEXT := JSON_VALUE(l_result,'$.next_cursor');
      END;
      ```
    }
    execution {
      sequence: 10
      point: beforeHeader
    }
  )
  region contexts (
    name: My contexts
    type: classicReport
    layout {
      sequence: 20
      slot: body
    }
    source {
      location: localDatabase
      type: sqlQuery
      sqlQuery:
      ```sql
      SELECT j.title, INITCAP(j.lifecycle) lifecycle, j.updated_at,
       apex_page.get_url(p_page=>13,p_clear_cache=>'13',p_items=>'P13_CONTEXT_ID',p_values=>j.context_id) detail_url
      FROM JSON_TABLE(kcv_personal_context_api.list_contexts(:P10_STATUS,:P10_SEARCH,:P10_CURSOR,20), '$.contexts[*]'
       COLUMNS(display_order FOR ORDINALITY, context_id VARCHAR2(32) PATH '$.context_id', title VARCHAR2(800) PATH '$.title',
       lifecycle VARCHAR2(16) PATH '$.lifecycle', updated_at VARCHAR2(80) PATH '$.updated_at')) j
      ORDER BY j.display_order
      ```
    }
    appearance {
      template: @/standard
      templateOptions: #DEFAULT#
    }
    reportLayout {
      numberOfRowsType: staticValue
      numberOfRows: 20
    }
    componentAppearance {
      template: @/standard
    }
    messages {
      whenNoDataFound: No saved contexts match. Create a context to get started.
    }
    column TITLE (
      reportColumnQueryId: 1
      type: link
      heading {
        heading: Context
        alignment: start
      }
      layout {
        sequence: 10
        columnAlignment: start
      }
      sorting {
        sortable: false
      }
      security {
        escapeSpecialChars: true
      }
      link {
        target: {
          type: url
          url: #DETAIL_URL#
        }
        linkText: #TITLE#
      }
    )
    column LIFECYCLE (
      reportColumnQueryId: 2
      type: plainText
      heading {
        heading: Status
        alignment: start
      }
      layout {
        sequence: 20
        columnAlignment: start
      }
      sorting {
        sortable: false
      }
      security {
        escapeSpecialChars: true
      }
    )
    column UPDATED_AT (
      reportColumnQueryId: 3
      type: plainText
      heading {
        heading: Last updated
        alignment: start
      }
      layout {
        sequence: 30
        columnAlignment: start
      }
      sorting {
        sortable: false
      }
      security {
        escapeSpecialChars: true
      }
    )
    column DETAIL_URL (
      reportColumnQueryId: 4
      type: hidden
      layout {
        sequence: 40
      }
      security {
        escapeSpecialChars: true
      }
    )
  )
)
