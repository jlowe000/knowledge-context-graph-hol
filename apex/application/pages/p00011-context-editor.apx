page 11 (
  name: Context editor
  alias: CONTEXT-EDITOR
  title: Context editor
  appearance {
    pageTemplate: @/standard
    templateOptions: #DEFAULT#
  }
  navigation {
    warnOnUnsavedChanges: true
  }
  security {
    authentication: required
    pageAccessProtection: argumentsMustHaveChecksum
    formAutoComplete: false
  }
  region editor (
    name: Describe your starting point
    type: staticContent
    layout {
      sequence: 10
      slot: body
    }
    appearance {
      template: @/standard
      templateOptions: #DEFAULT#
    }
    source {
      htmlCode:
      ```html
      <p>A name is enough to save a draft. Add what you know; leave uncertainty visible. Saving does not call a model or change the shared knowledge graph. After saving, review and explicitly apply your draft to use it in conversations. Topics select evidence; your objective and background guide interpretation.</p>
      ```
    }
  )
  pageItem P11_CONTEXT_ID (
    type: hidden
    layout {
      sequence: 1
      region: @editor
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
  pageItem P11_VERSION (
    type: hidden
    layout {
      sequence: 2
      region: @editor
      slot: regionBody
    }
    settings {
      valueProtected: true
    }
    sessionState {
      storage: session
    }
    security {
      sessionStateProtection: checksumRequiredSessionLevel
    }
  )
  pageItem P11_TOKEN (
    type: hidden
