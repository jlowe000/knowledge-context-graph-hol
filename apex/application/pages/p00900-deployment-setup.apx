      hot: true
    }
    behavior {
      action: redirectThisApp
      target: {
        page: 10
      }
    }
    security {
      authorizationScheme: @learning-ready
    }
  )
  region checks (
    name: Required checks
    type: classicReport
    layout {
      sequence: 20
      slot: body
    }
    source {
      location: localDatabase
      type: sqlQuery
      sqlQuery:
      ```sql
      SELECT CASE step_id
        WHEN 'schema' THEN 'Database objects'
        WHEN 'network' THEN 'Graph network'
        WHEN 'profile' THEN 'Model profile'
        WHEN 'model_test' THEN 'Model connection test'
        WHEN 'runtime' THEN 'Conversation components'
        WHEN 'dataset' THEN 'Public collection' ELSE step_id END step_name,
        status, next_action, error_code
      FROM JSON_TABLE(apex_session_state.get_clob('P900_STATUS'),'$.steps[*]' COLUMNS(
        ord FOR ORDINALITY, step_id VARCHAR2(32) PATH '$.id',
        status VARCHAR2(32) PATH '$.status', next_action VARCHAR2(1000) PATH '$.next_action',
        error_code VARCHAR2(64) PATH '$.error_code'))
      ORDER BY ord
      ```
    }
    appearance {
      template: @/standard
      templateOptions: #DEFAULT#
    }
    reportLayout {
      numberOfRowsType: staticValue
      numberOfRows: 10
    }
    componentAppearance {
      template: @/standard
    }
    column STEP_NAME (
      reportColumnQueryId: 1
      type: plainText
      heading {
        heading: Check
        alignment: start
      }
      layout {
        sequence: 10
        columnAlignment: start
      }
      sorting {
        sortable: false
      }
      security {
        escapeSpecialChars: true
      }
    )
    column STATUS (
      reportColumnQueryId: 2
      type: plainText
      heading {
        heading: Status
        alignment: start
      }
      layout {
        sequence: 20
        columnAlignment: start
      }
      sorting {
        sortable: false
      }
      security {
        escapeSpecialChars: true
      }
    )
    column NEXT_ACTION (
      reportColumnQueryId: 3
      type: plainText
      heading {
        heading: Next action
        alignment: start
      }
      layout {
        sequence: 30
        columnAlignment: start
      }
      sorting {
        sortable: false
      }
      security {
        escapeSpecialChars: true
      }
    )
    column ERROR_CODE (
      reportColumnQueryId: 4
      type: plainText
      heading {
        heading: Error code
        alignment: start
      }
      layout {
        sequence: 40
        columnAlignment: start
      }
      sorting {
        sortable: false
      }
      security {
        escapeSpecialChars: true
      }
    )
  )
