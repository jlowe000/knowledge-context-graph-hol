    lov {
      type: sqlQuery
      sqlQuery:
      ```sql
SELECT j.label d,j.label r FROM JSON_TABLE(kcv_personal_context_api.topic_options(:P11_CONTEXT_ID),'$.topics[*]' COLUMNS(label VARCHAR2(800) PATH '$')) j ORDER BY j.label
      ```
    }
    multipleValues {
      type: jsonArray
    }
