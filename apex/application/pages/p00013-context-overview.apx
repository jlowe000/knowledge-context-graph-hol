  button review (
    buttonName: REVIEW
    label: Review and apply draft
    layout {
      sequence: 5
      region: @overview
      slot: bottom
    }
    appearance {
      buttonTemplate: @/text
      hot: true
    }
    behavior {
      action: redirectUrl
      targetUrl: &P13_REVIEW_URL!RAW.
      executeValidations: false
    }
    serverSideCondition {
      type: expression
      language: plsql
      plsqlExpression: :P13_LIFECYCLE <> 'ARCHIVED'
    }
  )
