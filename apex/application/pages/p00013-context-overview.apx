      }
      layout {
        sequence: 20
        columnAlignment: start
      }
      sorting {
        sortable: false
      }
      security {
        escapeSpecialChars: true
      }
    )
    column ERROR_CODE (
      reportColumnQueryId: 3
      type: plainText
